/* Dark launcher, fuzzy matching and a keyboard-first workflow. */
* { bg: #171b26; fg: #d8e2f5; accent: #8aadf4; font: "JetBrains Mono 11"; }
window { width: 600px; height: 420px; background-color: @bg; border: 2px; border-color: @accent; border-radius: 16px; }
mainbox { padding: 20px; spacing: 10px; children: [ title, inputbar, listview, footer ]; }
entry { background-color: #202737; text-color: @fg; border-color: #43516d; placeholder-color: #7d8da9; }
element { background-color: #202737; text-color: @fg; border-color: #303a50; border-radius: 10px; }
element selected { background-color: #385078; text-color: #ffffff; border-color: @accent; }
element hover { background-color: #2c3a53; }
title { enabled: true; text: "qqs / saved rices"; font: "JetBrains Mono 15"; text-color: @fg; }
footer { text: "{shortcuts}"; text-color: #92a1ba; }
configuration { search-mode: "fuzzy"; mouse-single-click: false; background-gradient: false; wave-depth: 0; show-logo: false; list-sort: "name"; }
