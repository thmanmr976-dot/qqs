/* Original qqs appearance. */
/* qqs Rasi settings. Reopen the launcher or reload to apply. */
configuration {
    row-hover: "#deefff";
    add-text: "Import";
    row-background: "#f3f8ff";
    placeholder-color: "#7d91ae";
    row-border: "#d4e6ff";
    footer-text: "{shortcuts}";
    row-radius: 12;
    background: "#eaf4ff";
    wave-depth: 5;
    input-border: "#70b8ff";
    text-color: "#20365c";
    input-background: "#f5f9ff";
    corner-radius: 28;
    border-color: "#349cff";
    show-logo: true;
    placeholder: "Search rices or paste a GitHub URL / local path";
    row-height: 40;
    row-selected: "#bddfff";
    height: 400;
    button-text-color: "#ffffff";
    button-color: "#1767dc";
    empty-text: "Import a rice using a GitHub URL or local path.";
    width: 560;
    font-size: 11;
    font: "Noto Sans";
    border-width: 4;
    window-position: "center";
    window-offset-x: 0;
    window-offset-y: 0;
    background-opacity: 100;
    border-secondary-color: "#66d6ff";
    background-gradient: true;
    layout-padding: 26;
    layout-spacing: 8;
    layout-order: "title,input,list,footer";
    input-spacing: 9;
    input-position: "top";
    input-height: 40;
    input-padding: 12;
    input-radius: 12;
    input-border-width: 2;
    input-font: "";
    input-font-size: 0;
    input-text-color: "";
    input-selection-color: "#ffffff";
    input-selection-background: "#1767dc";
    button-width: 70;
    button-height: 40;
    button-radius: 12;
    button-hover-color: "#2978ed";
    button-font: "";
    button-font-size: 0;
    show-add-button: true;
    list-columns: 1;
    list-lines: 0;
    list-spacing: 5;
    show-scrollbar: true;
    row-padding: 20;
    row-border-width: 1;
    row-selected-border-width: 2;
    row-selected-border: "#349cff";
    row-text-color: "";
    row-selected-text-color: "";
    row-alternate: "";
    row-font: "";
    row-font-size: 0;
    row-alignment: "left";
    show-icons: false;
    icon-size: 24;
    row-show-index: false;
    row-show-source: false;
    list-sort: "import";
    show-title: false;
    title-text: "qqs";
    title-font: "";
    title-font-size: 18;
    title-color: "";
    show-footer: true;
    footer-font: "";
    footer-font-size: 0;
    footer-color: "";
    logo-size: 36;
    search-mode: "substring";
    search-case-sensitive: false;
    search-fields: "name,source,path";
    navigation-wrap: true;
    mouse-single-click: true;
    hide-on-focus-loss: false;
    clear-query-on-open: true;
    live-reload: true;
    keys-accept: "Return;Enter";
    keys-next: "Down;Ctrl+j";
    keys-previous: "Up;Ctrl+k";
    keys-close: "Escape";
    keys-context: "Shift+F10";
    keys-add: "Ctrl+Return";
    keys-reload: "Ctrl+r";
    stylesheet-file: "";
    stylesheet: "";
    background-image: "";
    background-image-opacity: 100;
    logo-file: "";
    row-icon-file: "";
    row-icon-name: "preferences-desktop-theme";
    glass-effect: false;
    glass-highlight-color: "#ffffff";
    glass-strength: 55;
}
